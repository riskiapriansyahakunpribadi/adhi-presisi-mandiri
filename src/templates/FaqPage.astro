---
/*
PANDUAN EDIT
File: src/templates/FaqPage.astro
Fungsi: Template halaman Pertanyaan Teknis (FAQ) versi bahasa Indonesia dan Inggris menggunakan elemen native <details> dan <summary> yang aksesibel penuh dengan keyboard.
Boleh diedit: Proporsi kolom daftar FAQ dan panel referensi cepat di blok style.
Jangan diubah: Elemen semantik <details> dan <summary> agar buka-tutup pertanyaan tetap bekerja dengan keyboard (Tab, Enter, Spasi) tanpa bergantung pada JavaScript.
Cara mengedit: Ubah pertanyaan dan jawaban teknis melalui pages.faq.items pada src/i18n/id.ts dan src/i18n/en.ts.
*/

import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';

import { companyData } from '../data/company';
import type { Lang } from '../i18n/routes';
import { getCopy, getRoute } from '../i18n/utils';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = getCopy(lang);
const pageCopy = copy.pages.faq;

const quoteHref = getRoute('quote', lang);
const insightsHref = getRoute('insights', lang);

// EDIT: Teks kotak referensi cepat di sisi kanan halaman FAQ.
const labels =
  lang === 'id'
    ? {
        quickRefHeading: 'Ringkasan data untuk penawaran',
        quickRefItems: [
          {
            term: 'Format file 3D dan 2D',
            detail: 'STEP, IGES, DWG, DXF, dan PDF berdimensi lengkap',
          },
          {
            term: 'Skala pesanan',
            detail: 'Satuan, prototipe, jig khusus, hingga batch kecil dan menengah',
          },
          {
            term: 'Toleransi dan waktu kerja',
            detail: 'Dikonfirmasi tertulis saat tim engineering meninjau gambar Anda',
          },
          {
            term: 'Jam operasional',
            detail: companyData.workingHours.id,
          },
        ],
        guideLink: 'Baca panduan penyiapan gambar teknik',
      }
    : {
        quickRefHeading: 'Quick quotation reference',
        quickRefItems: [
          {
            term: 'Accepted 3D and 2D formats',
            detail: 'STEP, IGES, DWG, DXF, and fully dimensioned PDF',
          },
          {
            term: 'Order volume',
            detail: 'Single pieces, prototypes, custom jigs, and small to medium batches',
          },
          {
            term: 'Tolerances and lead time',
            detail: 'Confirmed in writing when our engineering team reviews your drawing',
          },
          {
            term: 'Working hours',
            detail: companyData.workingHours.en,
          },
        ],
        guideLink: 'Read engineering drawing preparation guides',
      };
---

<BaseLayout lang={lang} title={pageCopy.title} description={pageCopy.description}>
  <section class="page-hero surface-dark" data-theme="dark">
    <div class="container">
      <div class="page-hero__inner">
        <h1 class="page-hero__title">{pageCopy.heading}</h1>
        <p class="page-hero__intro">{pageCopy.intro}</p>
      </div>
    </div>
  </section>

  <section class="section surface-light">
    <div class="container">
      <div class="faq-layout">
        <div class="faq-main">
          {pageCopy.items.length === 0 ? (
            <div class="empty-state">
              <h2>{copy.common.emptyListTitle}</h2>
              <p>{copy.common.emptyListBody}</p>
            </div>
          ) : (
            <div class="faq-list">
              {pageCopy.items.map((item, idx) => (
                <details class="faq-item" open={idx === 0}>
                  <summary class="faq-item__summary">
                    <span class="faq-item__question">{item.question}</span>
                    <span class="faq-item__icon" aria-hidden="true">
                      <Icon name="chevron-down" size={20} />
                    </span>
                  </summary>
                  <div class="faq-item__answer">
                    <p>{item.answer}</p>
                  </div>
                </details>
              ))}
            </div>
          )}
        </div>

        <aside class="faq-sidebar">
          <div class="ref-card">
            <h2 class="ref-card__heading">{labels.quickRefHeading}</h2>
            <dl class="ref-card__list">
              {labels.quickRefItems.map((entry) => (
                <div class="ref-card__row">
                  <dt>{entry.term}</dt>
                  <dd>{entry.detail}</dd>
                </div>
              ))}
            </dl>
            <div class="ref-card__guide">
              <Button href={insightsHref} variant="secondary" surface="light">
                {labels.guideLink}
              </Button>
            </div>
          </div>

          <div class="faq-cta surface-dark" data-theme="dark">
            <h2 class="faq-cta__heading">{pageCopy.ctaHeading}</h2>
            <Button href={quoteHref} variant="primary" surface="dark" fullWidth withArrow>
              {pageCopy.ctaButton}
            </Button>
          </div>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding-top: calc(var(--header-height) + clamp(3rem, 7vw, 5.25rem));
    padding-bottom: clamp(3rem, 6vw, 4.75rem);
  }

  .page-hero__inner {
    display: grid;
    gap: var(--space-4);
    max-width: 58rem;
  }

  .page-hero__title {
    color: var(--color-text-light);
    max-width: 24ch;
  }

  .page-hero__intro {
    font-size: var(--text-lg);
    color: var(--color-text-light-muted);
    max-width: 60ch;
  }

  .empty-state {
    padding: var(--space-6);
    border: 1px dashed var(--color-border-light-strong);
    border-radius: var(--radius-sm);
    background-color: var(--color-surface-light);
    display: grid;
    gap: var(--space-3);
  }

  .faq-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-7);
    align-items: start;
  }

  @media (min-width: 1024px) {
    .faq-layout {
      grid-template-columns: minmax(0, 1.3fr) minmax(300px, 0.78fr);
      gap: var(--space-8);
    }
  }

  .faq-list {
    display: grid;
    border-top: 1px solid var(--color-border-light-strong);
  }

  .faq-item {
    border-bottom: 1px solid var(--color-border-light);
    background-color: transparent;
  }

  .faq-item__summary {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 60px;
    padding-block: var(--space-4);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-text-dark);
    transition: color var(--dur-fast) var(--ease-standard);
  }

  .faq-item__summary::-webkit-details-marker {
    display: none;
  }

  @media (hover: hover) {
    .faq-item__summary:hover {
      color: var(--color-accent-on-light);
    }
  }

  .faq-item__icon {
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    display: grid;
    place-items: center;
    color: var(--color-accent-on-light);
    transition: transform var(--dur-base) var(--ease-standard);
  }

  .faq-item[open] .faq-item__icon {
    transform: rotate(180deg);
  }

  .faq-item__answer {
    padding-bottom: var(--space-5);
    padding-right: clamp(0rem, 3vw, 2.5rem);
    color: var(--color-text-dark-muted);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
  }

  .faq-sidebar {
    display: grid;
    gap: var(--space-5);
  }

  @media (min-width: 1024px) {
    .faq-sidebar {
      position: sticky;
      top: calc(var(--header-height) + 1.5rem);
    }
  }

  .ref-card {
    padding: var(--space-5);
    background-color: var(--color-surface-light);
    border: 1px solid var(--color-border-light);
    border-top: 3px solid var(--color-accent-on-light);
    border-radius: var(--radius-sm);
    display: grid;
    gap: var(--space-4);
  }

  .ref-card__heading {
    font-size: var(--text-lg);
    color: var(--color-text-dark);
  }

  .ref-card__list {
    margin: 0;
    display: grid;
    gap: var(--space-4);
  }

  .ref-card__row {
    display: grid;
    gap: 0.2rem;
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border-light);
  }

  .ref-card__row dt {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-text-dark-muted);
  }

  .ref-card__row dd {
    margin: 0;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text-dark);
  }

  .ref-card__guide {
    padding-top: var(--space-2);
  }

  .faq-cta {
    padding: var(--space-5);
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border-dark);
    display: grid;
    gap: var(--space-4);
  }

  .faq-cta__heading {
    font-size: var(--text-xl);
    color: var(--color-text-light);
  }
</style>