---
/*
PANDUAN EDIT
File: src/templates/InsightsPage.astro
Fungsi: Template halaman daftar artikel Wawasan versi bahasa Indonesia dan Inggris dengan artikel utama menonjol dan daftar artikel pendamping.
Boleh diedit: Proporsi grid artikel atau jarak antarbagian pada blok style.
Jangan diubah: Pengecekan kondisi kosong insightsData.length === 0 serta semantik urutan heading (h1 -> h2 -> h3).
Cara mengedit: Ubah atau tambah artikel pada src/data/insights.ts dan teks pengantar halaman pada pages.insights di src/i18n/id.ts dan src/i18n/en.ts.
*/

import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import CaliperDivider from '../components/CaliperDivider.astro';
import MediaFrame from '../components/MediaFrame.astro';

import { getInsightHref, insightsData } from '../data/insights';
import type { Lang } from '../i18n/routes';
import { getCopy, getRoute } from '../i18n/utils';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = getCopy(lang);
const pageCopy = copy.pages.insights;

const quoteHref = getRoute('quote', lang);
const faqHref = getRoute('faq', lang);

const [leadArticle, ...secondaryArticles] = insightsData;

const labels =
  lang === 'id'
    ? {
        faqCta: 'Buka pertanyaan teknis (FAQ)',
        ctaHeading: 'Butuh bantuan meninjau gambar teknik sebelum produksi?',
        ctaBody:
          'Jika ada keraguan soal pemilihan material atau kelengkapan file gambar, kirim langsung ke tim engineering kami lewat formulir penawaran.',
      }
    : {
        faqCta: 'Open technical FAQ',
        ctaHeading: 'Need help reviewing a drawing before machining?',
        ctaBody:
          'If you have questions on material selection or drawing completeness, share the details with our engineering team through the quote form.',
      };
---

<BaseLayout lang={lang} title={pageCopy.title} description={pageCopy.description}>
  <section class="page-hero surface-dark" data-theme="dark">
    <div class="container">
      <div class="page-hero__inner">
        <h1 class="page-hero__title">{pageCopy.heading}</h1>
        <p class="page-hero__intro">{pageCopy.intro}</p>
      </div>
    </div>
  </section>

  <section class="section surface-light">
    <div class="container">
      {!leadArticle ? (
        <div class="empty-state">
          <h2>{copy.common.emptyListTitle}</h2>
          <p>{copy.common.emptyListBody}</p>
        </div>
      ) : (
        <div class="insights-layout">
          <article class="lead-article reveal-item">
            <a
              href={getInsightHref(leadArticle, lang)}
              class="lead-article__link"
            >
              <div class="lead-article__media">
                <MediaFrame
                  slotId={leadArticle.imageSlot}
                  lang={lang}
                  ratio="16/9"
                  sizes="(max-width: 960px) 100vw, 56vw"
                  eager
                  hoverZoom
                  rounded="none"
                />
              </div>

              <div class="lead-article__body">
                <div class="article-meta">
                  <span class="article-meta__category">
                    {leadArticle.content[lang].category}
                  </span>
                  <span>{leadArticle.content[lang].readingLabel}</span>
                </div>

                <h2 class="lead-article__title">
                  {leadArticle.content[lang].title}
                </h2>
                <p class="lead-article__excerpt">
                  {leadArticle.content[lang].excerpt}
                </p>
                <span class="article-read-cta">{copy.common.readArticle}</span>
              </div>
            </a>
          </article>

          {secondaryArticles.length > 0 && (
            <div class="secondary-grid">
              {secondaryArticles.map((article, idx) => {
                const loc = article.content[lang];
                const href = getInsightHref(article, lang);
                const delay = Math.min(idx + 1, 2);

                return (
                  <article
                    class="article-card reveal-item"
                    data-delay={String(delay)}
                  >
                    <a href={href} class="article-card__link">
                      <MediaFrame
                        slotId={article.imageSlot}
                        lang={lang}
                        ratio="16/9"
                        sizes="(max-width: 768px) 100vw, 48vw"
                        hoverZoom
                        rounded="none"
                      />

                      <div class="article-card__body">
                        <div class="article-meta">
                          <span class="article-meta__category">{loc.category}</span>
                          <span>{loc.readingLabel}</span>
                        </div>
                        <h2 class="article-card__title">{loc.title}</h2>
                        <p class="article-card__excerpt">{loc.excerpt}</p>
                        <span class="article-read-cta">{copy.common.readArticle}</span>
                      </div>
                    </a>
                  </article>
                );
              })}
            </div>
          )}
        </div>
      )}
    </div>
  </section>

  <section class="section surface-dark-alt" data-theme="dark">
    <div class="container">
      <CaliperDivider surface="dark" class="insights-cta__divider" />

      <div class="insights-cta">
        <div class="insights-cta__copy">
          <h2 class="insights-cta__title">{labels.ctaHeading}</h2>
          <p class="insights-cta__body">{labels.ctaBody}</p>
        </div>
        <div class="insights-cta__actions">
          <Button href={quoteHref} variant="primary" surface="dark" withArrow>
            {copy.common.requestQuote}
          </Button>
          <Button href={faqHref} variant="outline" surface="dark">
            {labels.faqCta}
          </Button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding-top: calc(var(--header-height) + clamp(3rem, 7vw, 5.25rem));
    padding-bottom: clamp(3rem, 6vw, 4.75rem);
  }

  .page-hero__inner {
    display: grid;
    gap: var(--space-4);
    max-width: 58rem;
  }

  .page-hero__title {
    color: var(--color-text-light);
    max-width: 22ch;
  }

  .page-hero__intro {
    font-size: var(--text-lg);
    color: var(--color-text-light-muted);
    max-width: 58ch;
  }

  .empty-state {
    padding: var(--space-6);
    border: 1px dashed var(--color-border-light-strong);
    border-radius: var(--radius-sm);
    background-color: var(--color-surface-light);
    display: grid;
    gap: var(--space-3);
  }

  .insights-layout {
    display: grid;
    gap: var(--space-6);
  }

  .lead-article {
    background-color: var(--color-surface-light);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .lead-article__link {
    display: grid;
    grid-template-columns: 1fr;
    text-decoration: none;
    color: inherit;
  }

  @media (min-width: 960px) {
    .lead-article__link {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.95fr);
    }
  }

  .lead-article__media :global(.media-frame) {
    height: 100%;
    border: 0;
  }

  .lead-article__body {
    padding: clamp(1.5rem, 3.2vw, 2.75rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-4);
  }

  .lead-article__title {
    font-size: var(--text-2xl);
    color: var(--color-text-dark);
  }

  .lead-article__excerpt {
    font-size: var(--text-base);
    color: var(--color-text-dark-muted);
    line-height: var(--leading-normal);
  }

  .secondary-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 768px) {
    .secondary-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .article-card {
    background-color: var(--color-surface-light);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-sm);
    overflow: hidden;
    display: flex;
  }

  .article-card__link {
    display: flex;
    flex-direction: column;
    width: 100%;
    text-decoration: none;
    color: inherit;
  }

  .article-card__body {
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    flex: 1 1 auto;
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.7rem;
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-text-dark-muted);
  }

  .article-meta__category {
    color: var(--color-accent-on-light);
  }

  .article-card__title {
    font-size: var(--text-xl);
    color: var(--color-text-dark);
  }

  .article-card__excerpt {
    font-size: var(--text-sm);
    color: var(--color-text-dark-muted);
    flex: 1 1 auto;
  }

  .article-read-cta {
    margin-top: var(--space-1);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-accent-on-light);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  @media (hover: hover) {
    .lead-article:hover,
    .article-card:hover {
      border-color: var(--color-border-light-strong);
    }
  }

  .insights-cta__divider {
    margin-bottom: var(--space-7);
  }

  .insights-cta {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
    align-items: center;
  }

  @media (min-width: 900px) {
    .insights-cta {
      grid-template-columns: minmax(0, 1.25fr) auto;
      gap: var(--space-6);
    }
  }

  .insights-cta__copy {
    display: grid;
    gap: var(--space-3);
  }

  .insights-cta__title {
    color: var(--color-text-light);
    max-width: 26ch;
  }

  .insights-cta__body {
    color: var(--color-text-light-muted);
    max-width: 58ch;
  }

  .insights-cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }
</style>