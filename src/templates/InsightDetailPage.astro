---
/*
PANDUAN EDIT
File: src/templates/InsightDetailPage.astro
Fungsi: Template halaman baca detail artikel Wawasan (ID dan EN) dengan tata letak baca yang nyaman dan tautan ke artikel teknis lainnya.
Boleh diedit: Lebar kolom baca artikel di blok style.
Jangan diubah: Urutan heading (h1 untuk judul artikel, h2 untuk subjudul bahasan, h3 untuk artikel lainnya) serta penanganan kondisi ketika isi sections masih kosong.
Cara mengedit: Tulis atau ubah isi paragraf artikel di src/data/insights.ts.
*/

import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import CaliperDivider from '../components/CaliperDivider.astro';
import MediaFrame from '../components/MediaFrame.astro';
import SectionHeading from '../components/SectionHeading.astro';

import { getInsightHref, insightsData, type InsightItem } from '../data/insights';
import type { Lang } from '../i18n/routes';
import { getCopy, getRoute } from '../i18n/utils';

export interface Props {
  lang: Lang;
  insight: InsightItem;
}

const { lang, insight } = Astro.props;
const copy = getCopy(lang);
const loc = insight.content[lang];
const insightsHref = getRoute('insights', lang);
const quoteHref = getRoute('quote', lang);

const otherInsights = insightsData.filter((item) => item.id !== insight.id);

const labels =
  lang === 'id'
    ? {
        backLabel: 'Semua wawasan teknis',
        emptyBody:
          'Isi lengkap artikel ini sedang disusun. Ringkasan panduan sudah dapat dibaca di atas atau diskusikan langsung bersama tim engineering kami.',
        ctaHeading: 'Ingin meninjau gambar teknik komponen Anda?',
        ctaBody:
          'Kirim file gambar atau rincian kebutuhan melalui formulir penawaran untuk ditinjau tim engineering kami.',
        otherHeading: 'Wawasan teknis lainnya',
      }
    : {
        backLabel: 'All technical insights',
        emptyBody:
          'The full article body is being finalized. You can review the summary above or contact our engineering team directly with your part question.',
        ctaHeading: 'Need a review on your component drawing?',
        ctaBody:
          'Send your drawing files or requirement notes through our quotation form for engineering review.',
        otherHeading: 'More technical insights',
      };
---

<BaseLayout lang={lang} title={loc.seoTitle} description={loc.seoDescription}>
  <article>
    <header class="article-hero surface-dark" data-theme="dark">
      <div class="container">
        <div class="article-hero__inner">
          <a href={insightsHref} class="back-link">
            <span>{labels.backLabel}</span>
          </a>

          <div class="article-hero__meta">
            <span class="article-hero__category">{loc.category}</span>
            <span>{loc.readingLabel}</span>
          </div>

          <h1 class="article-hero__title">{loc.title}</h1>
          <p class="article-hero__excerpt">{loc.excerpt}</p>
        </div>
      </div>
    </header>

    <section class="section surface-light">
      <div class="container">
        <div class="article-cover">
          <MediaFrame
            slotId={insight.imageSlot}
            lang={lang}
            ratio="16/9"
            sizes="(max-width: 960px) 100vw, 960px"
            eager
            rounded="sm"
          />
        </div>

        <div class="article-body">
          {loc.sections.length === 0 ? (
            <div class="article-empty">
              <p>{labels.emptyBody}</p>
            </div>
          ) : (
            loc.sections.map((sec) => (
              <section class="article-section">
                <h2 class="article-section__heading">{sec.heading}</h2>
                {sec.paragraphs.map((para) => (
                  <p class="article-section__para">{para}</p>
                ))}
                {sec.bullets && sec.bullets.length > 0 && (
                  <ul class="article-section__list">
                    {sec.bullets.map((bullet) => (
                      <li>{bullet}</li>
                    ))}
                  </ul>
                )}
              </section>
            ))
          )}

          <div class="article-cta surface-dark" data-theme="dark">
            <h2 class="article-cta__heading">{labels.ctaHeading}</h2>
            <p class="article-cta__body">{labels.ctaBody}</p>
            <div>
              <Button href={quoteHref} variant="primary" surface="dark" withArrow>
                {copy.common.requestQuote}
              </Button>
            </div>
          </div>
        </div>
      </div>
    </section>
  </article>

  <section class="section surface-paper">
    <div class="container">
      <CaliperDivider surface="light" class="related__divider" />

      <SectionHeading heading={labels.otherHeading} surface="light" />

      <div class="related-grid">
        {otherInsights.map((item) => {
          const itemLoc = item.content[lang];
          const itemHref = getInsightHref(item, lang);
          return (
            <article class="related-card">
              <a href={itemHref} class="related-card__link">
                <MediaFrame
                  slotId={item.imageSlot}
                  lang={lang}
                  ratio="16/9"
                  sizes="(max-width: 768px) 100vw, 46vw"
                  hoverZoom
                  rounded="none"
                />
                <div class="related-card__body">
                  <span class="related-card__category">{itemLoc.category}</span>
                  <h3 class="related-card__title">{itemLoc.title}</h3>
                  <p class="related-card__summary">{itemLoc.excerpt}</p>
                  <span class="related-card__cta">{copy.common.readArticle}</span>
                </div>
              </a>
            </article>
          );
        })}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .article-hero {
    padding-top: calc(var(--header-height) + clamp(2.75rem, 6vw, 4.75rem));
    padding-bottom: clamp(2.75rem, 6vw, 4.5rem);
  }

  .article-hero__inner {
    display: grid;
    gap: var(--space-4);
    max-width: 54rem;
    justify-items: start;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-text-light-muted);
    text-decoration: underline;
    text-decoration-color: var(--color-border-dark-strong);
    text-underline-offset: 0.25em;
  }

  .article-hero__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text-light-muted);
  }

  .article-hero__category {
    color: var(--color-accent);
  }

  .article-hero__title {
    color: var(--color-text-light);
    max-width: 24ch;
  }

  .article-hero__excerpt {
    font-size: var(--text-lg);
    color: var(--color-text-light-muted);
    max-width: 58ch;
  }

  .article-cover {
    max-width: 60rem;
    margin-inline: auto;
    margin-bottom: var(--space-7);
  }

  .article-body {
    max-width: 46rem;
    margin-inline: auto;
    display: grid;
    gap: var(--space-7);
  }

  .article-section {
    display: grid;
    gap: var(--space-4);
  }

  .article-section__heading {
    font-size: var(--text-2xl);
    color: var(--color-text-dark);
  }

  .article-section__para {
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--color-text-dark);
  }

  .article-section__list {
    margin: 0;
    padding-left: 1.25rem;
    display: grid;
    gap: 0.65rem;
    color: var(--color-text-dark-muted);
  }

  .article-empty {
    padding: var(--space-5);
    background-color: var(--color-surface-light);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-sm);
    color: var(--color-text-dark-muted);
  }

  .article-cta {
    padding: clamp(1.5rem, 3.5vw, 2.5rem);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border-dark);
    display: grid;
    gap: var(--space-4);
  }

  .article-cta__heading {
    font-size: var(--text-2xl);
    color: var(--color-text-light);
  }

  .article-cta__body {
    color: var(--color-text-light-muted);
  }

  .related__divider {
    margin-bottom: var(--space-7);
  }

  .related-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
  }

  @media (min-width: 768px) {
    .related-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .related-card {
    background-color: var(--color-bg-light);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-sm);
    overflow: hidden;
    display: flex;
  }

  .related-card__link {
    display: flex;
    flex-direction: column;
    width: 100%;
    text-decoration: none;
    color: inherit;
  }

  .related-card__body {
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    flex: 1 1 auto;
  }

  .related-card__category {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-accent-on-light);
  }

  .related-card__title {
    font-size: var(--text-lg);
    color: var(--color-text-dark);
  }

  .related-card__summary {
    font-size: var(--text-sm);
    color: var(--color-text-dark-muted);
    flex: 1 1 auto;
  }

  .related-card__cta {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-accent-on-light);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
</style>