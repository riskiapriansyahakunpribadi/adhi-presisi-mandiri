---
/*
PANDUAN EDIT
File: src/templates/AboutPage.astro
Fungsi: Template halaman Tentang Kami versi bahasa Indonesia dan Inggris berisi profil bengkel, ruang lingkup, prinsip kerja, dan informasi lokasi Cikarang.
Boleh diedit: Tata letak jarak antarbagian atau rasio kolom di blok style.
Jangan diubah: Pengecekan kondisi companyData.metrics agar angka perusahaan hanya tampil bila Anda sudah mengisi datanya di src/data/company.ts.
Cara mengedit: Ubah teks halaman di pages.about pada src/i18n/id.ts dan src/i18n/en.ts; ubah alamat dan data perusahaan di src/data/company.ts.
*/

import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import CaliperDivider from '../components/CaliperDivider.astro';
import Icon from '../components/Icon.astro';
import MediaFrame from '../components/MediaFrame.astro';
import SectionHeading from '../components/SectionHeading.astro';

import { capabilitiesData, getCapabilityHref } from '../data/capabilities';
import { companyData, isPlaceholderValue } from '../data/company';
import type { Lang } from '../i18n/routes';
import { getCopy, getRoute } from '../i18n/utils';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = getCopy(lang);
const about = copy.pages.about;

const quoteHref = getRoute('quote', lang);
const servicesHref = getRoute('services', lang);
const capabilitiesHref = getRoute('capabilities', lang);

const addressFull =
  lang === 'id' ? companyData.address.fullId : companyData.address.fullEn;
const hasPhone = !isPlaceholderValue(companyData.contact.phoneHref);
const hasEmail = !isPlaceholderValue(companyData.contact.email);

const labels =
  lang === 'id'
    ? {
        locationHeading: 'Lokasi dan jam operasional bengkel',
        addressLabel: 'Alamat bengkel',
        hoursLabel: 'Jam kerja',
        phoneLabel: 'Telepon',
        emailLabel: 'Email kerja',
        scopeLinkHeading: 'Empat bidang pengerjaan utama',
        servicesCta: 'Lihat daftar layanan',
        metricsHeading: 'Data ringkas perusahaan',
        foundedLabel: 'Tahun berdiri',
        employeesLabel: 'Jumlah personel',
        machinesLabel: 'Unit mesin',
        projectsLabel: 'Proyek selesai',
        certificationsLabel: 'Sertifikasi',
      }
    : {
        locationHeading: 'Workshop location and operating hours',
        addressLabel: 'Workshop address',
        hoursLabel: 'Working hours',
        phoneLabel: 'Phone',
        emailLabel: 'Work email',
        scopeLinkHeading: 'Four primary machining areas',
        servicesCta: 'View services list',
        metricsHeading: 'Company facts',
        foundedLabel: 'Established',
        employeesLabel: 'Team size',
        machinesLabel: 'Machines',
        projectsLabel: 'Completed jobs',
        certificationsLabel: 'Certifications',
      };

const verifiedMetrics: Array<{ label: string; value: string }> = [];
if (companyData.metrics.foundedYear) {
  verifiedMetrics.push({
    label: labels.foundedLabel,
    value: companyData.metrics.foundedYear,
  });
}
if (companyData.metrics.employeeCount) {
  verifiedMetrics.push({
    label: labels.employeesLabel,
    value: companyData.metrics.employeeCount,
  });
}
if (companyData.metrics.machineCount) {
  verifiedMetrics.push({
    label: labels.machinesLabel,
    value: companyData.metrics.machineCount,
  });
}
if (companyData.metrics.projectCount) {
  verifiedMetrics.push({
    label: labels.projectsLabel,
    value: companyData.metrics.projectCount,
  });
}
---

<BaseLayout lang={lang} title={about.title} description={about.description}>
  <section class="page-hero surface-dark" data-theme="dark">
    <div class="container">
      <div class="page-hero__inner">
        <h1 class="page-hero__title">{about.heading}</h1>
        <p class="page-hero__intro">{about.intro}</p>
        <div class="page-hero__actions">
          <Button href={quoteHref} variant="primary" surface="dark" withArrow>
            {about.ctaButton}
          </Button>
          <Button href={servicesHref} variant="outline" surface="dark">
            {labels.servicesCta}
          </Button>
        </div>
      </div>
    </div>
  </section>

  <section class="section surface-light">
    <div class="container">
      <div class="about-overview">
        <div class="about-overview__photos">
          <div class="about-overview__photo-wide reveal-item">
            <MediaFrame
              slotId="tentang-bengkel"
              lang={lang}
              ratio="4/3"
              sizes="(max-width: 960px) 100vw, 48vw"
              eager
              hoverZoom
              rounded="sm"
            />
          </div>
          <div class="about-overview__photo-tall reveal-item" data-delay="1">
            <MediaFrame
              slotId="tentang-inspeksi"
              lang={lang}
              ratio="3/4"
              sizes="(max-width: 960px) 70vw, 24vw"
              hoverZoom
              rounded="sm"
            />
          </div>
        </div>

        <div class="about-overview__text reveal-item" data-delay="1">
          <SectionHeading
            heading={about.facilityHeading}
            surface="light"
            class="about-overview__heading"
          />
          <p class="about-overview__body">{about.facilityBody}</p>

          <div class="about-scope-box">
            <h3 class="about-scope-box__title">{labels.scopeLinkHeading}</h3>
            <ul class="about-scope-box__list">
              {capabilitiesData.map((cap) => (
                <li>
                  <a href={getCapabilityHref(cap, lang)} class="about-scope-box__link">
                    <span>{cap.content[lang].title}</span>
                    <Icon name="arrow-right" size={16} />
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>

      {verifiedMetrics.length > 0 && (
        <div class="about-metrics">
          <CaliperDivider surface="light" class="about-metrics__divider" />
          <h2 class="sr-only">{labels.metricsHeading}</h2>
          <dl class="about-metrics__grid">
            {verifiedMetrics.map((metric) => (
              <div class="about-metrics__item">
                <dt>{metric.label}</dt>
                <dd>{metric.value}</dd>
              </div>
            ))}
          </dl>
        </div>
      )}

      {companyData.metrics.certifications.length > 0 && (
        <div class="about-certs">
          <h3 class="about-certs__heading">{labels.certificationsLabel}</h3>
          <ul class="about-certs__list">
            {companyData.metrics.certifications.map((cert) => (
              <li>{cert}</li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </section>

  <section class="section surface-dark-alt" data-theme="dark">
    <div class="container">
      <SectionHeading
        heading={about.principlesHeading}
        surface="dark"
      />

      <div class="principles-grid">
        {about.principles.map((item, idx) => {
          const delay = Math.min(idx, 2);
          return (
            <article
              class="principle-card reveal-item"
              data-delay={delay > 0 ? String(delay) : undefined}
            >
              <h3 class="principle-card__title">{item.title}</h3>
              <p class="principle-card__body">{item.body}</p>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <section class="section surface-paper">
    <div class="container">
      <CaliperDivider surface="light" class="about-location__divider" />

      <div class="about-location">
        <div class="about-location__info reveal-item">
          <SectionHeading
            heading={labels.locationHeading}
            surface="light"
            class="about-location__heading"
          />

          <dl class="location-list">
            <div class="location-list__row">
              <dt>
                <Icon name="map-pin" size={18} />
                <span>{labels.addressLabel}</span>
              </dt>
              <dd>{addressFull}</dd>
            </div>

            <div class="location-list__row">
              <dt>
                <Icon name="clock" size={18} />
                <span>{labels.hoursLabel}</span>
              </dt>
              <dd>{companyData.workingHours[lang]}</dd>
            </div>

            <div class="location-list__row">
              <dt>
                <Icon name="phone" size={18} />
                <span>{labels.phoneLabel}</span>
              </dt>
              <dd>
                {hasPhone ? (
                  <a href={`tel:${companyData.contact.phoneHref}`} class="location-list__link">
                    {companyData.contact.phoneDisplay}
                  </a>
                ) : (
                  <span class="location-list__placeholder">{companyData.contact.phoneDisplay}</span>
                )}
              </dd>
            </div>

            <div class="location-list__row">
              <dt>
                <Icon name="mail" size={18} />
                <span>{labels.emailLabel}</span>
              </dt>
              <dd>
                {hasEmail ? (
                  <a href={`mailto:${companyData.contact.email}`} class="location-list__link">
                    {companyData.contact.email}
                  </a>
                ) : (
                  <span class="location-list__placeholder">{companyData.contact.email}</span>
                )}
              </dd>
            </div>
          </dl>
        </div>

        <div class="about-cta-panel surface-dark reveal-item" data-theme="dark" data-delay="1">
          <h2 class="about-cta-panel__title">{about.ctaHeading}</h2>
          <p class="about-cta-panel__body">{copy.home.quoteBanner.body}</p>
          <div class="about-cta-panel__actions">
            <Button href={quoteHref} variant="primary" surface="dark" withArrow>
              {about.ctaButton}
            </Button>
            <Button href={capabilitiesHref} variant="outline" surface="dark">
              {copy.common.viewCapabilities}
            </Button>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding-top: calc(var(--header-height) + clamp(3rem, 7vw, 5.25rem));
    padding-bottom: clamp(3rem, 6vw, 4.75rem);
  }

  .page-hero__inner {
    display: grid;
    gap: var(--space-5);
    max-width: 58rem;
  }

  .page-hero__title {
    color: var(--color-text-light);
    max-width: 22ch;
  }

  .page-hero__intro {
    font-size: var(--text-lg);
    color: var(--color-text-light-muted);
    max-width: 60ch;
  }

  .page-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    padding-top: var(--space-2);
  }

  .about-overview {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-7);
    align-items: start;
  }

  @media (min-width: 960px) {
    .about-overview {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.95fr);
      gap: var(--space-8);
    }
  }

  .about-overview__photos {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 640px) {
    .about-overview__photos {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 0.85fr);
      align-items: end;
    }

    .about-overview__photo-tall {
      transform: translateY(1rem);
    }
  }

  .about-overview__heading {
    margin-bottom: var(--space-4);
  }

  .about-overview__body {
    font-size: var(--text-lg);
    color: var(--color-text-dark-muted);
    margin-bottom: var(--space-6);
  }

  .about-scope-box {
    padding: var(--space-5);
    background-color: var(--color-surface-light);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-sm);
    display: grid;
    gap: var(--space-4);
  }

  .about-scope-box__title {
    font-size: var(--text-base);
    color: var(--color-text-dark);
  }

  .about-scope-box__list {
    list-style: none;
    display: grid;
  }

  .about-scope-box__list li {
    border-top: 1px solid var(--color-border-light);
  }

  .about-scope-box__list li:last-child {
    border-bottom: 1px solid var(--color-border-light);
  }

  .about-scope-box__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    min-height: var(--tap-min);
    padding-block: 0.65rem;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text-dark);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-standard);
  }

  @media (hover: hover) {
    .about-scope-box__link:hover {
      color: var(--color-accent-on-light);
    }
  }

  .about-metrics {
    margin-top: var(--space-8);
  }

  .about-metrics__divider {
    margin-bottom: var(--space-6);
  }

  .about-metrics__grid {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: var(--space-5);
  }

  .about-metrics__item {
    padding: var(--space-5);
    background-color: var(--color-surface-light);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-sm);
    display: grid;
    gap: 0.35rem;
  }

  .about-metrics__item dt {
    font-size: var(--text-xs);
    color: var(--color-text-dark-muted);
    font-weight: 600;
  }

  .about-metrics__item dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 700;
    color: var(--color-text-dark);
  }

  .about-certs {
    margin-top: var(--space-6);
    display: grid;
    gap: var(--space-3);
  }

  .about-certs__heading {
    font-size: var(--text-base);
  }

  .about-certs__list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .about-certs__list li {
    padding: 0.45rem 0.9rem;
    border: 1px solid var(--color-border-light-strong);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    font-weight: 600;
    background-color: var(--color-surface-light);
  }

  .principles-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
  }

  @media (min-width: 768px) {
    .principles-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1080px) {
    .principles-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .principle-card {
    padding: clamp(1.5rem, 3vw, 2.25rem);
    background-color: var(--color-bg-dark);
    border: 1px solid var(--color-border-dark);
    border-top: 3px solid var(--color-accent);
    border-radius: var(--radius-sm);
    display: grid;
    gap: var(--space-3);
    align-content: start;
  }

  .principle-card__title {
    font-size: var(--text-xl);
    color: var(--color-text-light);
  }

  .principle-card__body {
    font-size: var(--text-sm);
    color: var(--color-text-light-muted);
    line-height: var(--leading-normal);
  }

  .about-location__divider {
    margin-bottom: var(--space-7);
  }

  .about-location {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-7);
    align-items: start;
  }

  @media (min-width: 960px) {
    .about-location {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      gap: var(--space-8);
    }
  }

  .about-location__heading {
    margin-bottom: var(--space-5);
  }

  .location-list {
    margin: 0;
    display: grid;
    border-top: 1px solid var(--color-border-light);
  }

  .location-list__row {
    display: grid;
    gap: 0.35rem;
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--color-border-light);
  }

  .location-list__row dt {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-text-dark-muted);
  }

  .location-list__row dd {
    margin: 0;
    font-size: var(--text-base);
    color: var(--color-text-dark);
    font-weight: 500;
  }

  .location-list__link {
    color: var(--color-accent-on-light);
    font-weight: 600;
  }

  .location-list__placeholder {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: var(--text-sm);
    color: var(--color-text-dark-muted);
  }

  .about-cta-panel {
    padding: clamp(1.75rem, 3.5vw, 2.75rem);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border-dark);
    display: grid;
    gap: var(--space-4);
  }

  .about-cta-panel__title {
    font-size: var(--text-2xl);
    color: var(--color-text-light);
    max-width: 22ch;
  }

  .about-cta-panel__body {
    color: var(--color-text-light-muted);
    font-size: var(--text-base);
  }

  .about-cta-panel__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    padding-top: var(--space-2);
  }
</style>