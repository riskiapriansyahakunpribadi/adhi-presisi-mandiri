---
/*
PANDUAN EDIT
File: src/templates/HomePage.astro
Fungsi: Template halaman Beranda lengkap untuk versi bahasa Indonesia dan Inggris mencakup seluruh bagian utama dari hero sampai ajakan penawaran.
Boleh diedit: Tata letak jarak antarbagian di blok style bila ingin menyesuaikan ruang putih.
Jangan diubah: Urutan heading (satu h1 di hero, h2 di setiap bagian, h3 pada kartu), kelas reveal-item langsung pada kartu, dan kondisi kosong daftar artikel.
Cara mengedit: Untuk mengubah teks, edit src/i18n/id.ts dan src/i18n/en.ts; untuk layanan/kapabilitas/artikel, edit file di src/data/.
*/

import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import CaliperDivider from '../components/CaliperDivider.astro';
import Icon from '../components/Icon.astro';
import MediaFrame from '../components/MediaFrame.astro';
import SectionHeading from '../components/SectionHeading.astro';
import WorkflowRuler from '../components/WorkflowRuler.astro';

import { capabilitiesData, getCapabilityHref } from '../data/capabilities';
import { heroVideoConfig } from '../data/images';
import { getInsightHref, insightsData } from '../data/insights';
import { getServiceHref, servicesData } from '../data/services';
import type { Lang } from '../i18n/routes';
import { getCopy, getRoute } from '../i18n/utils';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = getCopy(lang);

const aboutHref = getRoute('about', lang);
const servicesHref = getRoute('services', lang);
const capabilitiesHref = getRoute('capabilities', lang);
const insightsHref = getRoute('insights', lang);
const quoteHref = getRoute('quote', lang);

const chipPrompt =
  lang === 'id'
    ? 'Pilih kebutuhan untuk langsung mengisi formulir penawaran:'
    : 'Select your requirement to open the quotation form pre-selected:';
---

<BaseLayout
  lang={lang}
  title={copy.pages.home.title}
  description={copy.pages.home.description}
>
  <section class="hero surface-dark" data-theme="dark">
    <div class="hero__backdrop" aria-hidden="true">
      <MediaFrame
        slotId="hero-utama"
        lang={lang}
        ratio="fill"
        sizes="100vw"
        eager
        registrationMarks={false}
        scrim="strong"
        rounded="none"
        class="hero__media"
      />
      {heroVideoConfig.enabled && heroVideoConfig.src && (
        <video
          class="hero__video"
          data-hero-video
          data-video-src={heroVideoConfig.src}
          muted
          loop
          playsinline
          preload="none"
          hidden
        ></video>
      )}
    </div>

    <div class="container hero__container">
      <div class="hero__copy">
        <p class="hero__kicker">{copy.siteTagline}</p>

        <h1 class="hero__title">
          {copy.hero.titleLines.map((line, index) => (
            <span class="hero__line-mask">
              <span
                class:list={[
                  'hero__line-inner',
                  index === 1 ? 'hero__line-inner--delay' : '',
                ]}
              >
                {line}
              </span>
            </span>
          ))}
        </h1>

        <p class="hero__subtitle">{copy.hero.subtitle}</p>

        <div class="hero__actions">
          <Button href={quoteHref} variant="primary" surface="dark" withArrow>
            {copy.hero.primaryCta}
          </Button>
          <Button href={capabilitiesHref} variant="outline" surface="dark">
            {copy.hero.secondaryCta}
          </Button>
        </div>
      </div>
    </div>
  </section>

  <section class="section surface-light">
    <div class="container">
      <CaliperDivider surface="light" class="home-divider" />

      <div class="about-grid">
        <div class="about-grid__copy reveal-item">
          <SectionHeading
            heading={copy.home.aboutSection.heading}
            surface="light"
            class="about-grid__heading"
          />
          <p class="about-grid__lead">{copy.home.aboutSection.lead}</p>
          <p class="about-grid__body">{copy.home.aboutSection.body}</p>
          <div class="about-grid__action">
            <Button href={aboutHref} variant="secondary" surface="light">
              {copy.home.aboutSection.cta}
            </Button>
          </div>
        </div>

        <div class="about-grid__photos">
          <div class="about-grid__photo-main reveal-item" data-delay="1">
            <MediaFrame
              slotId="tentang-bengkel"
              lang={lang}
              ratio="4/3"
              sizes="(max-width: 900px) 100vw, 44vw"
              hoverZoom
              rounded="sm"
            />
          </div>
          <div class="about-grid__photo-accent reveal-item" data-delay="2">
            <MediaFrame
              slotId="tentang-inspeksi"
              lang={lang}
              ratio="3/4"
              sizes="(max-width: 900px) 60vw, 24vw"
              hoverZoom
              rounded="sm"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section surface-dark-alt" data-theme="dark">
    <div class="container">
      <div class="quality-statement reveal-item">
        <h2 class="quality-statement__headline">
          {copy.home.qualitySection.statement}
        </h2>
      </div>

      <div class="quality-layout">
        <div class="quality-layout__media reveal-item" data-delay="1">
          <MediaFrame
            slotId="kualitas-komponen"
            lang={lang}
            ratio="16/10"
            sizes="(max-width: 960px) 100vw, 56vw"
            hoverZoom
            rounded="sm"
          />
        </div>

        <div class="quality-layout__details reveal-item" data-delay="2">
          <p class="quality-layout__body">{copy.home.qualitySection.body}</p>
          <ul class="quality-points">
            {copy.home.qualitySection.points.map((point) => (
              <li class="quality-points__item">
                <span>{point}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section surface-light">
    <div class="container">
      <SectionHeading
        heading={copy.home.capabilitiesSection.heading}
        intro={copy.home.capabilitiesSection.intro}
        surface="light"
        align="split"
      />

      <div class="cap-bento">
        {capabilitiesData.map((item, idx) => {
          const loc = item.content[lang];
          const href = getCapabilityHref(item, lang);
          const spanClass =
            idx === 0
              ? 'cap-card--wide'
              : idx === 3
                ? 'cap-card--wide-alt'
                : 'cap-card--compact';
          const imgRatio = idx === 0 ? '16/10' : '4/3';
          const delay = Math.min(idx, 3);

          return (
            <article
              class:list={['cap-card', spanClass, 'reveal-item']}
              data-delay={delay > 0 ? String(delay) : undefined}
            >
              <a href={href} class="cap-card__link">
                <div class="cap-card__media">
                  <MediaFrame
                    slotId={item.imageSlot}
                    lang={lang}
                    ratio={imgRatio}
                    sizes={
                      idx === 0 || idx === 3
                        ? '(max-width: 900px) 100vw, 56vw'
                        : '(max-width: 900px) 100vw, 38vw'
                    }
                    hoverZoom
                    rounded="none"
                  />
                </div>
                <div class="cap-card__body">
                  <span class="cap-card__tag">{loc.shortTag}</span>
                  <h3 class="cap-card__title">{loc.title}</h3>
                  <p class="cap-card__summary">{loc.shortSummary}</p>
                  <span class="cap-card__cta">{copy.common.viewCapabilityDetail}</span>
                </div>
              </a>
            </article>
          );
        })}
      </div>

      <div class="section-footer-action">
        <Button href={capabilitiesHref} variant="secondary" surface="light">
          {copy.common.viewAllCapabilities}
        </Button>
      </div>
    </div>
  </section>

  <section class="section surface-paper">
    <div class="container">
      <CaliperDivider surface="light" class="home-divider" />

      <SectionHeading
        heading={copy.home.servicesSection.heading}
        intro={copy.home.servicesSection.intro}
        surface="light"
        align="split"
      />

      <div class="service-rows">
        {servicesData.map((service, idx) => {
          const loc = service.content[lang];
          const href = getServiceHref(service, lang);
          const delay = Math.min(idx, 3);
          return (
            <article
              class="service-row reveal-item"
              data-delay={delay > 0 ? String(delay) : undefined}
            >
              <div class="service-row__text">
                <h3 class="service-row__title">
                  <a href={href} class="service-row__title-link">
                    {loc.title}
                  </a>
                </h3>
                <p class="service-row__summary">{loc.shortSummary}</p>
                <Button href={href} variant="secondary" surface="light">
                  {copy.common.viewServiceDetail}
                </Button>
              </div>

              <a href={href} class="service-row__photo" aria-label={loc.title}>
                <MediaFrame
                  slotId={service.imageSlot}
                  lang={lang}
                  ratio="4/3"
                  sizes="(max-width: 768px) 100vw, 320px"
                  hoverZoom
                  rounded="sm"
                />
              </a>
            </article>
          );
        })}
      </div>

      <div class="section-footer-action">
        <Button href={servicesHref} variant="secondary" surface="light">
          {copy.common.viewAllServices}
        </Button>
      </div>
    </div>
  </section>

  <section class="section surface-dark" data-theme="dark">
    <div class="container">
      <SectionHeading
        heading={copy.home.advantagesSection.heading}
        surface="dark"
      />

      <div class="adv-grid">
        {copy.home.advantagesSection.items.map((item, idx) => {
          const delay = Math.min(idx, 3);
          return (
            <article
              class="adv-item reveal-item"
              data-delay={delay > 0 ? String(delay) : undefined}
            >
              <div class="adv-item__icon">
                <Icon name={item.icon} size={24} />
              </div>
              <h3 class="adv-item__title">{item.title}</h3>
              <p class="adv-item__desc">{item.description}</p>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <section class="section surface-light">
    <div class="container">
      <SectionHeading
        heading={copy.home.workflowSection.heading}
        intro={copy.home.workflowSection.intro}
        surface="light"
        align="split"
      />

      <WorkflowRuler steps={copy.home.workflowSection.steps} />
    </div>
  </section>

  <section class="section surface-paper">
    <div class="container">
      <CaliperDivider surface="light" class="home-divider" />

      <SectionHeading
        heading={copy.home.insightsSection.heading}
        intro={copy.home.insightsSection.intro}
        surface="light"
        align="split"
      />

      {insightsData.length === 0 ? (
        <div class="empty-state">
          <h3>{copy.common.emptyListTitle}</h3>
          <p>{copy.common.emptyListBody}</p>
        </div>
      ) : (
        <div class="insights-grid">
          {insightsData.map((article, idx) => {
            const loc = article.content[lang];
            const href = getInsightHref(article, lang);
            const delay = Math.min(idx, 2);
            return (
              <article
                class:list={[
                  'insight-card',
                  idx === 0 ? 'insight-card--lead' : '',
                  'reveal-item',
                ]}
                data-delay={delay > 0 ? String(delay) : undefined}
              >
                <a href={href} class="insight-card__link">
                  <div class="insight-card__media">
                    <MediaFrame
                      slotId={article.imageSlot}
                      lang={lang}
                      ratio="16/9"
                      sizes={
                        idx === 0
                          ? '(max-width: 960px) 100vw, 52vw'
                          : '(max-width: 960px) 100vw, 32vw'
                      }
                      hoverZoom
                      rounded="none"
                    />
                  </div>
                  <div class="insight-card__body">
                    <div class="insight-card__meta">
                      <span class="insight-card__category">{loc.category}</span>
                      <span>{loc.readingLabel}</span>
                    </div>
                    <h3 class="insight-card__title">{loc.title}</h3>
                    <p class="insight-card__excerpt">{loc.excerpt}</p>
                    <span class="insight-card__more">{copy.common.readArticle}</span>
                  </div>
                </a>
              </article>
            );
          })}
        </div>
      )}

      <div class="section-footer-action">
        <Button href={insightsHref} variant="secondary" surface="light">
          {copy.common.viewAllInsights}
        </Button>
      </div>
    </div>
  </section>

  <section class="section surface-dark-alt" data-theme="dark">
    <div class="container">
      <div class="quote-band">
        <div class="quote-band__copy reveal-item">
          <SectionHeading
            heading={copy.home.quoteBanner.heading}
            intro={copy.home.quoteBanner.body}
            surface="dark"
            class="quote-band__heading"
          />

          <Button href={quoteHref} variant="primary" surface="dark" withArrow>
            {copy.home.quoteBanner.cta}
          </Button>
        </div>

        <div class="quote-band__chips-panel reveal-item" data-delay="1">
          <p class="quote-band__prompt">{chipPrompt}</p>
          <div class="quote-chips">
            {copy.quoteForm.fields.needType.options.map((opt) => (
              <a
                href={`${quoteHref}?need=${encodeURIComponent(opt.value)}`}
                class="quote-chip"
              >
                {opt.label}
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    min-height: min(92dvh, 880px);
    display: flex;
    align-items: flex-end;
    padding-top: calc(var(--header-height) + clamp(3rem, 7vw, 5.5rem));
    padding-bottom: clamp(3rem, 6vw, 5rem);
    overflow: hidden;
  }

  .hero__backdrop {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero__media {
    width: 100%;
    height: 100%;
  }

  .hero__media :global(.media-frame__img) {
    animation: heroZoomOut var(--dur-hero-zoom) var(--ease-standard) both;
  }

  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.36;
    pointer-events: none;
  }

  .hero__container {
    position: relative;
    z-index: 1;
  }

  .hero__copy {
    display: grid;
    gap: var(--space-5);
    max-width: 56rem;
  }

  .hero__kicker {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text-light-muted);
  }

  .hero__title {
    max-width: 18ch;
    color: var(--color-text-light);
  }

  .hero__line-mask {
    display: block;
    overflow: hidden;
    padding-bottom: 0.06em;
  }

  .hero__line-inner {
    display: block;
    animation: heroLineReveal 640ms var(--ease-standard) both;
  }

  .hero__line-inner--delay {
    animation-delay: 110ms;
  }

  .hero__subtitle {
    font-size: var(--text-lg);
    line-height: var(--leading-normal);
    color: var(--color-text-light);
    max-width: 54ch;
    opacity: 0.92;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    padding-top: var(--space-2);
  }

  @keyframes heroZoomOut {
    from {
      transform: scale(1.08);
    }
    to {
      transform: scale(1);
    }
  }

  @keyframes heroLineReveal {
    from {
      transform: translateY(108%);
    }
    to {
      transform: translateY(0);
    }
  }

  .home-divider {
    margin-bottom: var(--space-7);
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-7);
    align-items: start;
  }

  @media (min-width: 960px) {
    .about-grid {
      grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.15fr);
      gap: var(--space-8);
    }
  }

  .about-grid__heading {
    margin-bottom: var(--space-5);
  }

  .about-grid__lead {
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--color-text-dark);
    margin-bottom: var(--space-4);
  }

  .about-grid__body {
    color: var(--color-text-dark-muted);
    margin-bottom: var(--space-5);
  }

  .about-grid__photos {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 640px) {
    .about-grid__photos {
      grid-template-columns: minmax(0, 1.45fr) minmax(0, 0.85fr);
      align-items: end;
    }

    .about-grid__photo-accent {
      transform: translateY(1.25rem);
    }
  }

  .quality-statement {
    display: grid;
    gap: var(--space-4);
    padding-bottom: var(--space-7);
    border-bottom: 1px solid var(--color-border-dark);
    margin-bottom: var(--space-7);
  }

  .quality-statement__headline {
    font-size: clamp(1.65rem, 1.25rem + 1.8vw, 2.75rem);
    line-height: 1.18;
    max-width: 28ch;
    color: var(--color-text-light);
  }

  .quality-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    align-items: center;
  }

  @media (min-width: 960px) {
    .quality-layout {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.9fr);
      gap: var(--space-7);
    }
  }

  .quality-layout__details {
    display: grid;
    gap: var(--space-5);
  }

  .quality-layout__body {
    color: var(--color-text-light-muted);
    font-size: var(--text-lg);
  }

  .quality-points {
    list-style: none;
    display: grid;
  }

  .quality-points__item {
    padding-block: var(--space-4);
    border-top: 1px solid var(--color-border-dark);
    color: var(--color-text-light);
    font-weight: 500;
  }

  .quality-points__item:last-child {
    border-bottom: 1px solid var(--color-border-dark);
  }

  /* Grid kapabilitas asimetris 12 kolom di layar lebar */
  .cap-bento {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
  }

  @media (min-width: 768px) {
    .cap-bento {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .cap-card--wide {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 1080px) {
    .cap-bento {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }

    .cap-card--wide {
      grid-column: span 7;
    }

    .cap-card--compact {
      grid-column: span 5;
    }

    .cap-card--wide-alt {
      grid-column: span 7;
    }
  }

  .cap-card {
    background-color: var(--color-surface-light);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-md);
    overflow: hidden;
    display: flex;
    transition: border-color var(--dur-base) var(--ease-standard);
  }

  .cap-card__link {
    display: flex;
    flex-direction: column;
    width: 100%;
    text-decoration: none;
    color: inherit;
  }

  .cap-card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-5);
    flex: 1 1 auto;
  }

  .cap-card__tag {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-accent-on-light);
  }

  .cap-card__title {
    font-size: var(--text-xl);
    color: var(--color-text-dark);
  }

  .cap-card__summary {
    color: var(--color-text-dark-muted);
    font-size: var(--text-sm);
    flex: 1 1 auto;
  }

  .cap-card__cta {
    margin-top: var(--space-2);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-accent-on-light);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  @media (hover: hover) {
    .cap-card:hover {
      border-color: var(--color-border-light-strong);
    }

    .cap-card:hover .cap-card__cta {
      color: var(--color-accent-on-light-hover);
    }
  }

  .service-rows {
    display: grid;
    border-top: 1px solid var(--color-border-light-strong);
  }

  .service-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    padding-block: var(--space-6);
    border-bottom: 1px solid var(--color-border-light);
    align-items: center;
  }

  @media (min-width: 768px) {
    .service-row {
      grid-template-columns: minmax(0, 1fr) 260px;
      gap: var(--space-6);
    }
  }

  @media (min-width: 1080px) {
    .service-row {
      grid-template-columns: minmax(0, 1fr) 320px;
    }
  }

  .service-row__text {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
  }

  .service-row__title {
    font-size: var(--text-2xl);
  }

  .service-row__title-link {
    text-decoration: none;
  }

  @media (hover: hover) {
    .service-row__title-link:hover {
      color: var(--color-accent-on-light);
    }
  }

  .service-row__summary {
    color: var(--color-text-dark-muted);
    max-width: 52ch;
  }

  .service-row__photo {
    display: block;
  }

  .adv-grid {
    display: grid;
    grid-template-columns: 1fr;
    border-top: 1px solid var(--color-border-dark);
    border-left: 1px solid var(--color-border-dark);
  }

  @media (min-width: 768px) {
    .adv-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .adv-item {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    border-right: 1px solid var(--color-border-dark);
    border-bottom: 1px solid var(--color-border-dark);
    background-color: var(--color-bg-dark);
  }

  .adv-item__icon {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    background-color: var(--color-surface-dark);
    border: 1px solid var(--color-border-dark);
    border-radius: var(--radius-sm);
    color: var(--color-accent);
  }

  .adv-item__title {
    font-size: var(--text-xl);
    color: var(--color-text-light);
  }

  .adv-item__desc {
    color: var(--color-text-light-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
  }

  .insights-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
  }

  @media (min-width: 768px) {
    .insights-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .insight-card--lead {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 1080px) {
    .insights-grid {
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr) minmax(0, 1fr);
    }

    .insight-card--lead {
