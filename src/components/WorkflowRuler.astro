---
/*
PANDUAN EDIT
File: src/components/WorkflowRuler.astro
Fungsi: Menampilkan 5 langkah Alur Kerja dalam bentuk garis waktu horizontal bergaya penggaris pengukur di desktop dan vertikal rapi di HP.
Boleh diedit: Jarak antarlangkah atau warna tanda skala pada blok style.
Jangan diubah: Semantik elemen <ol> dan <li> serta kelas reveal-item agar urutan 5 langkah dan gaya grid tetap utuh.
Cara mengedit: Ubah teks 5 langkah Alur Kerja melalui home.workflowSection.steps di src/i18n/id.ts dan src/i18n/en.ts.
*/

export interface WorkflowStep {
  code: string;
  mark: string;
  title: string;
  description: string;
}

export interface Props {
  steps: WorkflowStep[];
}

const { steps } = Astro.props;
---

<div class="ruler-timeline">
  <div class="ruler-timeline__rail" aria-hidden="true">
    <div class="ruler-timeline__ticks">
      {Array.from({ length: 41 }).map((_, idx) => (
        <span
          class:list={[
            'ruler-timeline__tick',
            idx % 10 === 0
              ? 'ruler-timeline__tick--major'
              : idx % 5 === 0
                ? 'ruler-timeline__tick--mid'
                : '',
          ]}
        ></span>
      ))}
    </div>
  </div>

  <ol class="ruler-timeline__list">
    {steps.map((step, index) => {
      const delay = Math.min(index, 4);
      return (
        <li
          class="ruler-step reveal-item"
          data-delay={delay > 0 ? String(delay) : undefined}
        >
          <div class="ruler-step__marker" aria-hidden="true">
            <span class="ruler-step__pin"></span>
            <span class="ruler-step__scale-mark">{step.mark}</span>
          </div>

          <div class="ruler-step__body">
            <h3 class="ruler-step__title">{step.title}</h3>
            <p class="ruler-step__desc">{step.description}</p>
          </div>
        </li>
      );
    })}
  </ol>
</div>

<style>
  .ruler-timeline {
    position: relative;
  }

  .ruler-timeline__rail {
    display: none;
  }

  .ruler-timeline__list {
    list-style: none;
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
    padding-left: 1.5rem;
    border-left: 2px solid var(--color-border-light-strong);
  }

  .ruler-step {
    position: relative;
    display: grid;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-5);
    background-color: var(--color-surface-light);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-sm);
  }

  .ruler-step__marker {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .ruler-step__pin {
    position: absolute;
    left: calc(-1.5rem - 7px);
    top: 1.4rem;
    width: 12px;
    height: 12px;
    background-color: var(--color-accent-on-light);
    border: 2px solid var(--color-bg-light);
  }

  .ruler-step__scale-mark {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-accent-on-light);
    font-variant-numeric: tabular-nums;
  }

  .ruler-step__body {
    display: grid;
    gap: 0.45rem;
  }

  .ruler-step__title {
    font-size: var(--text-lg);
    color: var(--color-text-dark);
  }

  .ruler-step__desc {
    font-size: var(--text-sm);
    color: var(--color-text-dark-muted);
    line-height: var(--leading-normal);
  }

  @media (min-width: 768px) and (max-width: 1079px) {
    .ruler-timeline__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      padding-left: 0;
      border-left: 0;
    }

    .ruler-step__pin {
      position: static;
      width: 10px;
      height: 10px;
      border: 0;
    }
  }

  @media (min-width: 1080px) {
    .ruler-timeline__rail {
      display: block;
      margin-bottom: var(--space-4);
      border-top: 2px solid var(--color-text-dark);
      border-bottom: 1px solid var(--color-border-light-strong);
      background-color: var(--color-surface-tint);
      padding-inline: 0.5rem;
    }

    .ruler-timeline__ticks {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      height: 28px;
    }

    .ruler-timeline__tick {
      width: 1px;
      height: 9px;
      background-color: var(--color-border-light-strong);
    }

    .ruler-timeline__tick--mid {
      height: 15px;
      background-color: var(--color-text-dark-muted);
    }

    .ruler-timeline__tick--major {
      width: 2px;
      height: 22px;
      background-color: var(--color-accent-on-light);
    }

    .ruler-timeline__list {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: var(--space-4);
      padding-left: 0;
      border-left: 0;
    }

    .ruler-step {
      padding: var(--space-4);
      align-content: start;
      border-top: 3px solid var(--color-border-light-strong);
      transition: border-color var(--dur-base) var(--ease-standard);
    }

    .ruler-step__pin {
      position: static;
      width: 8px;
      height: 8px;
      border: 0;
    }

    @media (hover: hover) {
      .ruler-step:hover {
        border-top-color: var(--color-accent-on-light);
      }
    }
  }
</style>