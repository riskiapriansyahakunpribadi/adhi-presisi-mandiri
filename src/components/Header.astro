---
/*
PANDUAN EDIT
File: src/components/Header.astro
Fungsi: Header pil melayang dengan logo monogram A, penanda halaman aktif, tombol ganti bahasa ID/EN, dan panel menu HP layar penuh yang aman hingga lebar 360px.
Boleh diedit: Jarak antar tautan navigasi pada layar desktop di blok style.
Jangan diubah: Atribut data-site-header, data-menu-toggle, data-menu-panel, data-menu-close, dan aria-current karena dibaca oleh src/scripts/site.ts.
Cara mengedit: Ubah teks menu atau CTA di src/i18n/id.ts dan src/i18n/en.ts; ubah nama singkat perusahaan di src/data/company.ts.
*/

import { companyData } from '../data/company';
import { getAlternatePath, type Lang } from '../i18n/routes';
import { getCopy, getRoute, isActiveNav } from '../i18n/utils';
import Button from './Button.astro';
import Icon from './Icon.astro';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = getCopy(lang);
const currentPath = Astro.url.pathname;
const otherLang: Lang = lang === 'id' ? 'en' : 'id';
const alternateHref = getAlternatePath(currentPath, otherLang);
const homeHref = getRoute('home', lang);
const quoteHref = getRoute('quote', lang);

const navLinks = copy.nav.items.map((item) => {
  const href = getRoute(item.key, lang);
  return {
    label: item.label,
    href,
    active: isActiveNav(currentPath, href),
  };
});
---

<header class="site-header" data-site-header data-theme="dark">
  <div class="site-header__shell">
    <a href={homeHref} class="site-header__brand" aria-label={companyData.legalName}>
      <svg
        class="site-header__logo-svg"
        width="30"
        height="30"
        viewBox="0 0 32 32"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
        focusable="false"
      >
        <rect x="0.75" y="0.75" width="30.5" height="30.5" rx="5.25" fill="#1C222A" stroke="#45505E" stroke-width="1.5" />
        <path d="M5 10V5H10M27 22V27H22" stroke="#8C96A4" stroke-width="1.5" stroke-linecap="square" />
        <path d="M9.5 24L14.6 9H17.4L22.5 24H19.4L18.2 20.2H13.8L12.6 24H9.5ZM14.6 17.6H17.4L16 12.8L14.6 17.6Z" fill="#F4F2EE" />
        <rect x="23" y="5" width="4" height="4" fill="#F26A1B" />
      </svg>
      <span class="site-header__brand-name">{companyData.shortName}</span>
    </a>

    <nav class="site-header__nav" aria-label={copy.nav.ariaLabel}>
      <ul class="site-header__list">
        {navLinks.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={['site-header__link', item.active ? 'is-active' : '']}
              aria-current={item.active ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="site-header__actions">
      <a
        href={alternateHref}
        class="lang-switch"
        aria-label={copy.nav.languageSwitchAria}
        hreflang={otherLang}
      >
        <span class:list={['lang-switch__code', lang === 'id' ? 'is-current' : '']}>ID</span>
        <span class="lang-switch__divider" aria-hidden="true">/</span>
        <span class:list={['lang-switch__code', lang === 'en' ? 'is-current' : '']}>EN</span>
      </a>

      <div class="site-header__cta-desktop">
        <Button href={quoteHref} variant="primary" surface="dark">
          {copy.nav.cta}
        </Button>
      </div>

      <button
        type="button"
        class="menu-trigger"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="panel-menu-utama"
      >
        <Icon name="menu" size={18} />
        <span>{copy.nav.menuButton}</span>
      </button>
    </div>
  </div>
</header>

<div
  id="panel-menu-utama"
  class="mobile-drawer surface-dark"
  data-menu-panel
  data-theme="dark"
  hidden
>
  <div class="mobile-drawer__top">
    <a href={homeHref} class="site-header__brand" aria-label={companyData.legalName}>
      <svg
        class="site-header__logo-svg"
        width="30"
        height="30"
        viewBox="0 0 32 32"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
        focusable="false"
      >
        <rect x="0.75" y="0.75" width="30.5" height="30.5" rx="5.25" fill="#1C222A" stroke="#45505E" stroke-width="1.5" />
        <path d="M5 10V5H10M27 22V27H22" stroke="#8C96A4" stroke-width="1.5" stroke-linecap="square" />
        <path d="M9.5 24L14.6 9H17.4L22.5 24H19.4L18.2 20.2H13.8L12.6 24H9.5ZM14.6 17.6H17.4L16 12.8L14.6 17.6Z" fill="#F4F2EE" />
        <rect x="23" y="5" width="4" height="4" fill="#F26A1B" />
      </svg>
      <span class="site-header__brand-name">{companyData.shortName}</span>
    </a>

    <button
      type="button"
      class="mobile-drawer__close"
      data-menu-close
      aria-label={copy.nav.closeMenu}
    >
      <span>{copy.nav.closeMenu}</span>
    </button>
  </div>

  <nav class="mobile-drawer__nav" aria-label={copy.nav.ariaLabel}>
    <ul class="mobile-drawer__list">
      {navLinks.map((item) => (
        <li>
          <a
            href={item.href}
            class:list={['mobile-drawer__link', item.active ? 'is-active' : '']}
            aria-current={item.active ? 'page' : undefined}
          >
            <span>{item.label}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <div class="mobile-drawer__footer">
    <div class="mobile-drawer__lang-row">
      <a
        href={alternateHref}
        class="lang-switch lang-switch--drawer"
        aria-label={copy.nav.languageSwitchAria}
        hreflang={otherLang}
      >
        <span class:list={['lang-switch__code', lang === 'id' ? 'is-current' : '']}>ID</span>
        <span class="lang-switch__divider" aria-hidden="true">/</span>
        <span class:list={['lang-switch__code', lang === 'en' ? 'is-current' : '']}>EN</span>
      </a>
      <span class="mobile-drawer__hours">{companyData.workingHours[lang]}</span>
    </div>

    <Button href={quoteHref} variant="primary" surface="dark" fullWidth>
      {copy.nav.cta}
    </Button>
  </div>
</div>

<style>
  .site-header {
    position: fixed;
    top: 0.75rem;
    left: 0;
    right: 0;
    z-index: var(--z-header);
    padding-inline: var(--gutter);
    pointer-events: none;
    transition:
      transform var(--dur-base) var(--ease-standard),
      top var(--dur-base) var(--ease-standard);
  }

  .site-header.is-scrolled {
    top: 0.5rem;
  }

  .site-header.is-hidden {
    transform: translateY(calc(-100% - 1.5rem));
  }

  .site-header__shell {
    pointer-events: auto;
    width: min(100%, var(--container-max));
    margin-inline: auto;
    min-height: 60px;
    padding: 0.45rem 0.65rem 0.45rem 0.85rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    background-color: rgba(18, 22, 27, 0.92);
    backdrop-filter: blur(10px);
    color: var(--color-text-light);
    border: 1px solid var(--color-border-dark);
    border-radius: var(--radius-pill);
    box-shadow: var(--shadow-header);
    transition:
      min-height var(--dur-base) var(--ease-standard),
      padding var(--dur-base) var(--ease-standard),
      background-color var(--dur-base) var(--ease-standard);
  }

  .site-header.is-scrolled .site-header__shell {
    min-height: 54px;
    padding-block: 0.35rem;
    background-color: rgba(18, 22, 27, 0.96);
  }

  .site-header__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    min-height: var(--tap-min);
    padding-inline: 0.2rem;
    text-decoration: none;
    color: var(--color-text-light);
    flex-shrink: 0;
  }

  .site-header__logo-svg {
    flex-shrink: 0;
    display: block;
  }

  .site-header__brand-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .site-header__nav {
    display: none;
  }

  .site-header__list {
    display: flex;
    align-items: center;
    gap: 0.2rem;
    list-style: none;
  }

  .site-header__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    padding: 0.4rem 0.68rem;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text-light-muted);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-standard);
  }

  .site-header__link::after {
    content: '';
    position: absolute;
    left: 0.68rem;
    right: 0.68rem;
    bottom: 0.55rem;
    height: 2px;
    background-color: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform var(--dur-base) var(--ease-standard);
  }

  .site-header__link.is-active {
    color: var(--color-text-light);
    font-weight: 600;
  }

  .site-header__link.is-active::after {
    transform: scaleX(1);
  }

  @media (hover: hover) {
    .site-header__link:hover {
      color: var(--color-text-light);
    }

    .site-header__link:hover::after {
      transform: scaleX(1);
    }
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .lang-switch {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
    min-height: var(--tap-min);
    min-width: 60px;
    padding: 0.3rem 0.65rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-border-dark);
    background-color: var(--color-surface-dark);
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 700;
    text-decoration: none;
    color: var(--color-text-light-muted);
    transition: border-color var(--dur-fast) var(--ease-standard);
  }

  .lang-switch__code.is-current {
    color: var(--color-text-light);
  }

  .lang-switch__divider {
    opacity: 0.45;
  }

  @media (hover: hover) {
    .lang-switch:hover {
      border-color: var(--color-border-dark-strong);
      color: var(--color-text-light);
    }
  }

  .site-header__cta-desktop {
    display: none;
  }

  .menu-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: var(--tap-min);
    padding: 0.45rem 0.9rem;
    border-radius: var(--radius-pill);
    background-color: var(--color-surface-dark-elevated);
    border: 1px solid var(--color-border-dark-strong);
    color: var(--color-text-light);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 700;
    transition:
      background-color var(--dur-fast) var(--ease-standard),
      transform var(--dur-fast) var(--ease-press);
  }

  .menu-trigger:active {
    transform: scale(0.97);
  }

  /* Penyesuaian khusus layar HP kecil (360px sampai 420px) agar header tidak pernah sesak atau meluber. */
  @media (max-width: 420px) {
    .site-header__shell {
      padding: 0.38rem 0.45rem 0.38rem 0.6rem;
      gap: 0.4rem;
    }

    .site-header__brand {
      gap: 0.45rem;
      padding-inline: 0.1rem;
    }

    .site-header__logo-svg {
      width: 26px;
      height: 26px;
    }

    .site-header__brand-name {
      font-size: 0.95rem;
    }

    .site-header__actions {
      gap: 0.35rem;
    }

    .lang-switch {
      min-width: 52px;
      padding: 0.25rem 0.5rem;
    }

    .menu-trigger {
      padding: 0.4rem 0.72rem;
      gap: 0.35rem;
      font-size: var(--text-xs);
    }
  }

  @media (min-width: 768px) {
    .site-header__cta-desktop {
      display: block;
    }

    .site-header__cta-desktop :global(.btn--primary) {
      border-radius: var(--radius-pill);
      padding: 0.65rem 1.15rem;
    }
  }

  @media (min-width: 1080px) {
    .site-header__nav {
      display: block;
    }

    .menu-trigger {
      display: none;
    }
  }

  :global(body.menu-open) {
    overflow: hidden;
  }

  .mobile-drawer {
    position: fixed;
    inset: 0;
    z-index: var(--z-drawer);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-5);
    padding: 1rem var(--gutter) 1.75rem;
    overflow-y: auto;
    opacity: 0;
    transition: opacity var(--dur-base) var(--ease-standard);
  }

  .mobile-drawer[hidden] {
    display: none;
  }

  .mobile-drawer.is-open {
    opacity: 1;
  }

  .mobile-drawer__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-border-dark);
  }

  .mobile-drawer__close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--tap-min);
    padding: 0.5rem 1rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border-dark-strong);
    color: var(--color-text-light);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .mobile-drawer__nav {
    flex: 1 1 auto;
    display: flex;
    align-items: center;
  }

  .mobile-drawer__list {
    width: 100%;
    list-style: none;
    display: grid;
    gap: 0.25rem;
  }

  .mobile-drawer__link {
    display: flex;
    align-items: center;
    min-height: 52px;
    padding: 0.65rem 0.5rem;
    border-bottom: 1px solid var(--color-border-dark);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-text-light);
    text-decoration: none;
  }

  .mobile-drawer__link.is-active {
    color: var(--color-accent);
  }

  .mobile-drawer__footer {
    display: grid;
    gap: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border-dark);
  }

  .mobile-drawer__lang-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .mobile-drawer__hours {
    font-size: var(--text-xs);
    color: var(--color-text-light-muted);
  }
</style>