---
/*
PANDUAN EDIT
File: src/components/Footer.astro
Fungsi: Footer situs dengan ajakan penawaran, informasi bengkel Cikarang, daftar kapabilitas, dan baris keterangan proyek demonstrasi.
Boleh diedit: Susunan kolom di blok style bila ingin menambah tautan baru.
Jangan diubah: Baris demoNotice di bagian bawah dan pemeriksaan isPlaceholderValue agar placeholder kontak tidak menjadi tautan rusak.
Cara mengedit: Ubah alamat, jam kerja, atau kontak di src/data/company.ts; ubah teks label di src/i18n/id.ts dan src/i18n/en.ts.
*/

import { companyData, isPlaceholderValue } from '../data/company';
import type { Lang } from '../i18n/routes';
import { getCopy, getRoute } from '../i18n/utils';
import Button from './Button.astro';
import CaliperDivider from './CaliperDivider.astro';
import Icon from './Icon.astro';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = getCopy(lang);
const quoteHref = getRoute('quote', lang);

const capabilityPaths: Record<string, Record<Lang, string>> = {
  'permesinan-cnc': {
    id: '/kapabilitas/permesinan-cnc/',
    en: '/en/capabilities/cnc-machining/',
  },
  'jig-dan-fixture': {
    id: '/kapabilitas/jig-dan-fixture/',
    en: '/en/capabilities/jigs-and-fixtures/',
  },
  'suku-cadang': {
    id: '/kapabilitas/suku-cadang-mesin/',
    en: '/en/capabilities/machine-spare-parts/',
  },
  'pembuatan-ulang': {
    id: '/kapabilitas/pembuatan-ulang-komponen/',
    en: '/en/capabilities/reverse-engineering/',
  },
};

const capabilityLinks = copy.quoteForm.fields.needType.options
  .filter((opt) => opt.value in capabilityPaths)
  .map((opt) => ({
    label: opt.label,
    href: capabilityPaths[opt.value][lang],
  }));

const hasPhone = !isPlaceholderValue(companyData.contact.phoneHref);
const hasEmail = !isPlaceholderValue(companyData.contact.email);
const addressFull =
  lang === 'id' ? companyData.address.fullId : companyData.address.fullEn;
const year = new Date().getFullYear();
---

<footer class="site-footer surface-dark" data-theme="dark">
  <div class="container">
    <CaliperDivider surface="dark" compact />

    <div class="site-footer__cta-band">
      <div class="site-footer__cta-copy">
        <h2 class="site-footer__cta-title">{copy.footer.ctaHeading}</h2>
        <p class="site-footer__cta-body">{copy.footer.ctaBody}</p>
      </div>
      <div class="site-footer__cta-action">
        <Button href={quoteHref} variant="primary" surface="dark" withArrow>
          {copy.footer.ctaButton}
        </Button>
      </div>
    </div>

    <div class="site-footer__grid">
      <div class="site-footer__col site-footer__col--workshop">
        <p class="site-footer__brand">{companyData.legalName}</p>
        <p class="site-footer__tagline">{copy.siteTagline}</p>

        <dl class="site-footer__details">
          <div class="site-footer__detail-row">
            <dt>
              <Icon name="map-pin" size={16} />
              <span>{copy.footer.contactHeading}</span>
            </dt>
            <dd>{addressFull}</dd>
          </div>

          <div class="site-footer__detail-row">
            <dt>
              <Icon name="clock" size={16} />
              <span>{copy.footer.hoursLabel}</span>
            </dt>
            <dd>{companyData.workingHours[lang]}</dd>
          </div>

          <div class="site-footer__detail-row">
            <dt>
              <Icon name="phone" size={16} />
              <span>{copy.footer.phoneLabel}</span>
            </dt>
            <dd>
              {hasPhone ? (
                <a href={`tel:${companyData.contact.phoneHref}`} class="site-footer__inline-link">
                  {companyData.contact.phoneDisplay}
                </a>
              ) : (
                <span class="site-footer__placeholder">{companyData.contact.phoneDisplay}</span>
              )}
            </dd>
          </div>

          <div class="site-footer__detail-row">
            <dt>
              <Icon name="mail" size={16} />
              <span>{copy.footer.emailLabel}</span>
            </dt>
            <dd>
              {hasEmail ? (
                <a href={`mailto:${companyData.contact.email}`} class="site-footer__inline-link">
                  {companyData.contact.email}
                </a>
              ) : (
                <span class="site-footer__placeholder">{companyData.contact.email}</span>
              )}
            </dd>
          </div>
        </dl>
      </div>

      <div class="site-footer__col">
        <h3 class="site-footer__heading">{copy.footer.capabilitiesHeading}</h3>
        <ul class="site-footer__list">
          {capabilityLinks.map((item) => (
            <li>
              <a href={item.href} class="site-footer__link">{item.label}</a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="site-footer__bottom">
      <p class="site-footer__copyright">
        &copy; {year} {copy.footer.copyrightPrefix}.
      </p>
      <p class="site-footer__demo-notice">{copy.footer.demoNotice}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding-top: var(--space-7);
    padding-bottom: var(--space-6);
  }

  .site-footer__cta-band {
    display: grid;
    gap: var(--space-5);
    align-items: center;
    padding-block: var(--space-7);
    border-bottom: 1px solid var(--color-border-dark);
  }

  @media (min-width: 840px) {
    .site-footer__cta-band {
      grid-template-columns: minmax(0, 1.35fr) auto;
      gap: var(--space-6);
    }
  }

  .site-footer__cta-copy {
    display: grid;
    gap: var(--space-3);
  }

  .site-footer__cta-title {
    font-size: var(--text-2xl);
    max-width: 24ch;
  }

  .site-footer__cta-body {
    color: var(--color-text-light-muted);
    max-width: 54ch;
  }

  .site-footer__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-7);
    padding-block: var(--space-7);
    border-bottom: 1px solid var(--color-border-dark);
  }

  @media (min-width: 840px) {
    .site-footer__grid {
      grid-template-columns: minmax(0, 1.55fr) minmax(0, 0.95fr);
    }
  }

  .site-footer__brand {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-text-light);
  }

  .site-footer__tagline {
    margin-top: 0.35rem;
    color: var(--color-text-light-muted);
    font-size: var(--text-sm);
  }

  .site-footer__details {
    margin: var(--space-5) 0 0;
    display: grid;
    gap: 0.9rem;
  }

  .site-footer__detail-row {
    display: grid;
    gap: 0.2rem;
  }

  .site-footer__detail-row dt {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-text-light-muted);
  }

  .site-footer__detail-row dd {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-text-light);
    max-width: 48ch;
  }

  .site-footer__placeholder {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: var(--text-xs);
    color: var(--color-text-light-muted);
  }

  .site-footer__heading {
    font-size: var(--text-sm);
    color: var(--color-accent);
    margin-bottom: var(--space-4);
  }

  .site-footer__list {
    list-style: none;
    display: grid;
    gap: 0.25rem;
  }

  .site-footer__link,
  .site-footer__inline-link {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    font-size: var(--text-sm);
    color: var(--color-text-light-muted);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-standard);
  }

  .site-footer__inline-link {
    min-height: 0;
    color: var(--color-text-light);
    text-decoration: underline;
    text-decoration-color: var(--color-border-dark-strong);
  }

  @media (hover: hover) {
    .site-footer__link:hover,
    .site-footer__inline-link:hover {
      color: var(--color-text-light);
      text-decoration: underline;
      text-decoration-color: var(--color-accent);
    }
  }

  .site-footer__bottom {
    padding-top: var(--space-5);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.65rem 1.5rem;
    font-size: var(--text-xs);
    color: var(--color-text-light-muted);
  }

  .site-footer__demo-notice {
    color: var(--color-text-light-muted);
  }
</style>